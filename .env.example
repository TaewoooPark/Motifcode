# Copy to .env and fill in the key. `motif` reads MOTIF_* from the environment,
# then ./.env, then ~/.motif/.env — flags outrank all three. The key is sent as
# a bearer token and withheld from every command the agent runs.
MOTIF_ENDPOINT=https://llm.onerouter.pro/v1
MOTIF_MODEL=motif/motif-3
MOTIF_API_KEY=sk-...

# Morphfactory (BETA): choose /provider in the session or use --provider morphfactory.
# When selecting through this file, replace MOTIF_ENDPOINT above with:
# MOTIF_ENDPOINT=https://api-cbt.morphfactory.io/v1
# Keep each provider's key separate; changing providers preserves the other key.
# MOTIF_MORPHFACTORY_API_KEY=your-morphfactory-key
