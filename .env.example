# Copy to .env and fill in the key for the provider you use.
# OpenRouter is the default. The CLI selects the Motif-3 model ID for each provider.
OPENROUTER_API_KEY=your-openrouter-key

# Infron
# MOTIF_ENDPOINT=https://llm.onerouter.pro/v1
# MOTIF_API_KEY=your-infron-key

# Morphfactory (BETA)
# MOTIF_ENDPOINT=https://api-cbt.morphfactory.io/v1
# MOTIF_MORPHFACTORY_API_KEY=your-morphfactory-key
